---
import { url } from '../lib/content';
import { sections, type Section } from '../lib/sections';

interface Props {
  title: string;
  sections: Section[];
}

// One link per listed section that has a navbar entry.
const items = Astro.props.sections.flatMap((name) => sections[name] ?? []);
---

<nav class="nav">
  <ul class="menu">
    <li><a href={url('/')}><img src={url('img/logo_notext.png')} class="logo" alt="SAUVC" /></a></li>
    {items.map(({ label, anchor }) => <li><a href={url(`#${anchor}`)}>{label}</a></li>)}
  </ul>
</nav>

<nav class="mobile-menu">
  <label for="show-menu">
    <span class="mobile-title">{Astro.props.title}</span>
    <span class="lines"></span>
  </label>
  <input type="checkbox" id="show-menu" />
  <ul>
    {items.map(({ label, anchor }) => <li><a href={url(`#${anchor}`)}>{label}</a></li>)}
  </ul>
</nav>

<style>
  .nav, .mobile-menu {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 1;
    background: var(--white);
    border-bottom: 1px solid var(--light-color);
  }

  .nav {
    padding: 1em;
  }

  .menu {
    list-style-type: none;
    margin: 0;
    padding: 0;

    li {
      display: inline-block;
      margin: 0 0.75em;
    }
  }

  .logo {
    width: 55px;
    margin: -20px;
    margin-right: 0;
  }

  .mobile-menu {
    display: none;
    line-height: 1.6em;
    text-align: center;

    label {
      display: block;
      color: var(--primary-color);
      padding: 10px 15px;
      cursor: pointer;
      text-transform: uppercase;
    }

    input {
      display: none;
    }

    ul {
      display: none;
      list-style-type: none;
      margin: 0 auto;
      padding-left: 0;
    }

    input:checked ~ ul {
      display: block;
    }

    li {
      margin-bottom: 1px;
    }

    a {
      display: block;
      color: var(--primary-color);
      padding: 10px 0;
      transition: all 0.4s ease 0s;

      &:hover {
        background-color: var(--light-color);
        text-decoration: none;
      }
    }
  }

  .mobile-title {
    font-size: 1.5em;
    font-weight: bold;
    color: var(--dark-color);
    padding-left: 35px;
  }

  .lines {
    border-bottom: 15px double var(--primary-color);
    border-top: 5px solid var(--primary-color);
    height: 5px;
    width: 15px;
    padding-right: 15px;
    float: right;
  }

  @media screen and (max-width: 800px) {
    .nav {
      display: none;
    }
    .mobile-menu {
      display: block;
    }
  }
</style>
