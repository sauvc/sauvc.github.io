---
import { one } from '../../lib/content';

const { videos } = await one('media');
const { year } = await one('edition');

/** Embed URL for a YouTube playlist URL. */
const embed = (playlist: string) =>
  `https://www.youtube.com/embed/videoseries?controls=0&list=${new URL(playlist).searchParams.get('list')}`;
---

<section id="videos">
  <h3>Videos from SAUVC {year}</h3>

  <ul class="videos">
    {videos.map((v) => (
      <li>
        <iframe
          width="560"
          height="315"
          src={embed(v.playlist)}
          title={v.title}
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
          allowfullscreen></iframe>
        <p>{v.title}</p>
      </li>
    ))}
  </ul>
</section>

<style>
  .videos {
    display: flex;
    flex-wrap: wrap;
    list-style-type: none;
    justify-content: center;
    column-gap: 7vw;
    padding: 0;

    iframe {
      max-width: 100%;
      border: 0;
    }
    p {
      text-align: center;
    }
  }
</style>
