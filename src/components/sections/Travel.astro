---
import { cards, one, url } from '../../lib/content';

const travel = await one('travel');
const info = await cards('travelCards');
---

<section id="travel">
  <h2>Travel</h2>
  <img class="landscape" src={url(travel.image)} alt={travel.city} loading="lazy" />

  <ul class="info-list">
    {info.map(({ title, link, Content }) => (
      <li>
        <p class="info-title">{title}</p>
        <div class="info-content"><Content /></div>
        {link && <a href={link} class="more">More Information</a>}
      </li>
    ))}
  </ul>
</section>

<style>
  .more {
    margin: .2em;

    &::after {
      content: "›";
      display: inline-block;
      padding-left: .3em;
      margin: .5em 0;
    }
    &:hover, &:active {
      color: var(--primary-color);
    }
  }
</style>
