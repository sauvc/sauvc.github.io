---
import { one, url } from '../../lib/content';

const { photos, videos } = await one('media');
const { year } = await one('edition');

/** Embed URL for a YouTube playlist URL. */
const embed = (playlist: string) =>
  `https://www.youtube.com/embed/videoseries?controls=0&list=${new URL(playlist).searchParams.get('list')}`;
---

<section id="media">
  <h2>Media</h2>

  {photos.days.length > 0 && (
    <>
      <h3>Photos from SAUVC {year}</h3>
      <ul class="social">
        {photos.days.map((link, i) => (
          <li>
            <a href={link} aria-label={`Day ${i + 1} on ${photos.name}`}><img src={url(photos.icon)} alt="" loading="lazy" />Day {i + 1}</a>
          </li>
        ))}
      </ul>
    </>
  )}

  {videos.length > 0 && (
    <>
      <h3>Videos from SAUVC {year}</h3>
      <ul class="videos">
        {videos.map((v) => (
          <li>
            <iframe
              width="560"
              height="315"
              src={embed(v.playlist)}
              title={v.title}
              loading="lazy"
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
              allowfullscreen></iframe>
            <p>{v.title}</p>
          </li>
        ))}
      </ul>
    </>
  )}
</section>

<style>
  .videos {
    display: flex;
    flex-wrap: wrap;
    list-style-type: none;
    justify-content: center;
    column-gap: 7vw;
    padding: 0;

    iframe {
      max-width: 100%;
      border: 0;
    }

    p {
      text-align: center;
    }
  }
</style>
