---
import { text, url } from '../../lib/content';

const Description = await text('competition');
---

<section id="competition">
  <h2>Competition</h2>

  <ul class="auvs">
    {[1, 2, 3, 4].map((n) => (
      <li><img src={url(`img/auv/auv${n}.jpg`)} alt={`AUV design ${n}`} loading="lazy" /></li>
    ))}
  </ul>
  <Description />
</section>

<style>
  .auvs {
    padding: 0;
    list-style-type: none;
    display: flex;
    justify-content: space-between;

    img {
      max-width: 200px;
    }
  }

  @media only screen and (max-width: 1100px) {
    .auvs img { max-width: 150px; }
  }

  @media only screen and (max-width: 800px) {
    .auvs img { max-width: 120px; }
  }

  @media only screen and (max-width: 600px) {
    .auvs img { max-width: 80px; }
  }
</style>
