---
import { one, text, url } from '../../lib/content';

const venue = await one('venue');
const Address = await text('venue');
---

<section id="venue">
  <h2>Venue</h2>

  <div class="address"><Address /></div>

  {venue.images.length > 0 && (
    <div class="gallery">
      {venue.images.map((image) => <img src={url(image.path)} alt={image.name} loading="lazy" />)}
    </div>
  )}

  {venue.map && (
    <div class="map">
      <iframe src={venue.map} title="Map of the venue" allowfullscreen></iframe>
    </div>
  )}
</section>

<style>
  .address {
    margin: 1em 0;
    font-size: 1.4em;

    :global(p) {
      margin: 0;
    }
  }

  .gallery {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1em;
    margin: 1em 0;

    img {
      width: 100%;
      display: block;
    }
  }

  .map {
    position: relative;
    padding-bottom: 40%; /* height / width */
    height: 0;
    overflow: hidden;
    margin: 2em 0;

    iframe {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      border: 0;
    }
  }

  @media only screen and (max-width: 800px) {
    .gallery {
      grid-template-columns: 1fr;
    }
  }
</style>
