---
import { one, text, url } from '../lib/content';

const supporters = await one('supporters');
const Organisers = await text('supporters');
---

<footer class="footer">
  <div class="logos">
    {supporters.list.map((s) => (
      <a href={s.url}><img src={url(s.image_path)} alt={s.name} loading="lazy" /></a>
    ))}
  </div>
  <div class="organisers"><Organisers /></div>
  <svg viewBox="0 0 100 12">
    <path fill="#A0DCF1" opacity="0.2" d="M0 12 V9 Q30 10 40 7 T85 6 T100 2 V12z" />
    <path fill="#A0DCF1" opacity="0.5" d="M0 12 V10 Q30 1.5 60 10 V12z" />
    <path fill="#A0DCF1" d="M0 12 V9 Q30 10 60 7 T100 8 V12z" />
  </svg>
</footer>

<style>
  .footer {
    height: 100px;
    margin-top: 3em;

    img {
      display: block;
      margin: 1.5em auto;
      height: 50px;
    }
  }

  .organisers {
    text-align: center;
    font-size: 1.2em;
    margin: 0 .5em -70px .5em;

    :global(p) {
      margin: 0;
    }
  }

  .logos {
    display: flex;
    justify-content: space-around;
    margin-bottom: 25px;
  }

  @media only screen and (max-width: 1100px) {
    .organisers {
      margin-bottom: -20px;
    }
  }

  @media only screen and (max-width: 800px) {
    .footer {
      margin-top: 2em;
    }
    .organisers {
      font-size: 1em;
      margin-bottom: 0;
    }
  }

  @media only screen and (max-width: 600px) {
    .logos {
      display: block;

      img {
        margin-bottom: 20px;
      }
    }
  }
</style>
